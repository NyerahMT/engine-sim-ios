<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE plist PUBLIC
    "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">

<dict>

    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <key>NSCameraUsageDescription</key>
    <string>Engine Simulator does not intentionally use the camera. This permission may be requested by a linked system or input library.</string>

    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Engine Simulator may use Bluetooth to communicate with compatible external controllers and input devices.</string>

    <key>CFBundleDisplayName</key>
    <string>Engine Simulator: iOS</string>

    <key>CFBundleExecutable</key>
    <string>EngineSim</string>

    <key>CFBundleIdentifier</key>
    <string>com.nyerahmt.enginesimulator</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>Engine Simulator: iOS</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>0.1</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- ProMotion / >60 Hz -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>

    <!--
        Expose Documents through the Files app.

        Files
          On My iPhone
            Engine Simulator: iOS
              Custom Engines
    -->
    <key>UIFileSharingEnabled</key>
    <true/>

    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- Register Engine Simulator .mr scripts with iOS -->
    <key>CFBundleDocumentTypes</key>
    <array>

        <dict>

            <key>CFBundleTypeName</key>
            <string>Engine Simulator Script</string>

            <key>CFBundleTypeRole</key>
            <string>Editor</string>

            <key>LSHandlerRank</key>
            <string>Owner</string>

            <key>LSItemContentTypes</key>
            <array>
                <string>com.nyerahmt.engine-simulator.mr</string>
            </array>

        </dict>

    </array>

    <key>UTExportedTypeDeclarations</key>
    <array>

        <dict>

            <key>UTTypeIdentifier</key>
            <string>com.nyerahmt.engine-simulator.mr</string>

            <key>UTTypeDescription</key>
            <string>Engine Simulator Script</string>

            <key>UTTypeConformsTo</key>
            <array>
                <string>public.source-code</string>
                <string>public.plain-text</string>
            </array>

            <key>UTTypeTagSpecification</key>
            <dict>

                <key>public.filename-extension</key>
                <array>
                    <string>mr</string>
                </array>

                <key>public.mime-type</key>
                <string>text/plain</string>

            </dict>

        </dict>

    </array>

    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string></string>
    </dict>

    <key>UIRequiresFullScreen</key>
    <true/>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>

    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>

</dict>

</plist>
