<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE plist PUBLIC
    "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">

<dict>

    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <key>CFBundleDisplayName</key>
    <string>Engine Simulator</string>

    <key>CFBundleExecutable</key>
    <string>EngineSim</string>

    <key>CFBundleIdentifier</key>
    <string>com.nyeraht.engine-sim-ios</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>Engine Simulator</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>0.1</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <key>MinimumOSVersion</key>
    <string>15.0</string>

    <!--
        Expose the app's Documents directory in the iOS Files app.

        This gives users:
        Files
          > On My iPhone
            > Engine Simulator
              > Custom Engines
    -->
    <key>UIFileSharingEnabled</key>
    <true/>

    <!--
        Allow Files to edit/manage documents in place rather than
        requiring every document to be copied into a temporary area.
    -->
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!--
        Tell iOS that Engine Simulator understands .mr files.
        This also gives Safari/Files/Discord a chance to offer
        Engine Simulator in document actions.
    -->
    <key>CFBundleDocumentTypes</key>
    <array>

        <dict>

            <key>CFBundleTypeName</key>
            <string>Engine Simulator Engine Script</string>

            <key>CFBundleTypeRole</key>
            <string>Editor</string>

            <key>LSHandlerRank</key>
            <string>Owner</string>

            <key>LSItemContentTypes</key>
            <array>
                <string>com.nyeraht.engine-simulator.mr</string>
            </array>

        </dict>

    </array>

    <!--
        Define the custom .mr extension for iOS.
    -->
    <key>UTExportedTypeDeclarations</key>
    <array>

        <dict>

            <key>UTTypeIdentifier</key>
            <string>com.nyeraht.engine-simulator.mr</string>

            <key>UTTypeDescription</key>
            <string>Engine Simulator Engine Script</string>

            <key>UTTypeConformsTo</key>
            <array>
                <string>public.source-code</string>
                <string>public.plain-text</string>
            </array>

            <key>UTTypeTagSpecification</key>
            <dict>

                <key>public.filename-extension</key>
                <array>
                    <string>mr</string>
                </array>

                <key>public.mime-type</key>
                <string>text/plain</string>

            </dict>

        </dict>

    </array>

    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string></string>
    </dict>

    <key>UIRequiresFullScreen</key>
    <true/>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>

    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>

</dict>

</plist>
