{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "ENGINE_SIM_BUILD_DESKTOP": "OFF",
        "ENGINE_SIM_BUILD_SCRIPTING": "OFF"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64 core and tests",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-x86_64",
      "displayName": "macOS x86_64 core and tests",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "linux-x86_64",
      "displayName": "Linux x86_64 core and tests",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-x86_64",
      "displayName": "Windows x86_64 core and tests",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "macos-arm64-desktop",
      "displayName": "macOS arm64 SDL desktop host",
      "inherits": "macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "OFF",
        "ENGINE_SIM_BUILD_DESKTOP": "ON",
        "ENGINE_SIM_BUILD_SCRIPTING": "ON"
      }
    },
    {
      "name": "linux-x86_64-desktop",
      "displayName": "Linux x86_64 SDL desktop host",
      "inherits": "linux-x86_64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "OFF",
        "ENGINE_SIM_BUILD_DESKTOP": "ON",
        "ENGINE_SIM_BUILD_SCRIPTING": "ON"
      }
    },
    {
      "name": "windows-x86_64-desktop",
      "displayName": "Windows x86_64 SDL desktop host",
      "inherits": "windows-x86_64",
      "generator": "Visual Studio 17 2022",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "OFF",
        "ENGINE_SIM_BUILD_DESKTOP": "ON",
        "ENGINE_SIM_BUILD_SCRIPTING": "ON"
      }
    },
    {
      "name": "macos-arm64-package",
      "displayName": "macOS arm64 packaged SDL app",
      "inherits": "macos-arm64-desktop",
      "cacheVariables": {
        "ENGINE_SIM_MACOS_APP_BUNDLE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    },
    {
      "name": "macos-x86_64",
      "configurePreset": "macos-x86_64"
    },
    {
      "name": "linux-x86_64",
      "configurePreset": "linux-x86_64"
    },
    {
      "name": "windows-x86_64",
      "configurePreset": "windows-x86_64"
    },
    {
      "name": "macos-arm64-desktop",
      "configurePreset": "macos-arm64-desktop"
    },
    {
      "name": "linux-x86_64-desktop",
      "configurePreset": "linux-x86_64-desktop"
    },
    {
      "name": "windows-x86_64-desktop",
      "configurePreset": "windows-x86_64-desktop",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos-arm64-package",
      "configurePreset": "macos-arm64-package"
    }
  ],
  "testPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-x86_64",
      "configurePreset": "macos-x86_64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x86_64",
      "configurePreset": "linux-x86_64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x86_64",
      "configurePreset": "windows-x86_64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
